# Copy to .env and fill in. `serp-bench` reads .env next to bench.yaml; real environment
# variables win over this file. Never commit keys.

# ScrapeBeaver (providers/scrapebeaver)
SCRAPEBEAVER_API_KEY=
# Optional: point the adapter at another host (staging, a local stand-in).
# SCRAPEBEAVER_BASE_URL=

# Decodo (providers/decodo): the API key of the Web Data API, sent as a Bearer token.
DECODO_API_KEY=

# ScrapingBee (providers/scrapingbee): the API key, sent as a Bearer token.
SCRAPINGBEE_API_KEY=

# Scrapingdog (providers/scrapingdog): the API key from the dashboard.
SCRAPINGDOG_API_KEY=

# Bright Data (providers/brightdata): the API key, sent as a Bearer token, and the name of
# the SERP API zone created in the account (the name it was given there).
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# Serper (providers/serper): the API key from the dashboard, sent in the X-API-KEY header.
SERPER_API_KEY=

# Oxylabs (providers/oxylabs): the API key of a Web API instance, sent as a Bearer token.
OXYLABS_API_KEY=
